    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=⚠️ *Missing rubric*\n\nA submission came in for assignment `{{ $('Normalize Payload').item.json.assignment_id }}` but no matching rubric exists in the Rubrics sheet.\n\nStudent: {{ $('Normalize Payload').item.json.student_name }} ({{ $('Normalize Payload').item.json.student_id }})\n\nAdd the rubric row and ask the student to resubmit.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "f0f71616-f08e-4e04-9024-2bea69d82c8b",
      "name": "Alert Missing Rubric",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1216,
        528
      ]
    },
    {
      "parameters": {
        "jsCode": "// ----- Get input data -----\nconst data = $input.first().json;                       // Fetch Rubric output\nconst prev = $('Normalize Payload').first().json;       // Original submission\n\nconst text = (prev.essay_text || '').toString();\n\n// ----- Word tokenization -----\nconst cleaned = text.replace(/[,.!?;:()[\\]{}\"\"''—–\\-/\\\\@#$%^&*_+=<>|~`]/g, ' ');\nconst words = cleaned.split(/\\s+/).filter(w => w.length > 0);\nconst wordCount = words.length;\n\n// ----- Sentence counting -----\nconst sentences = text.replace(/[!?]/g, '.').split('.').filter(s => s.trim().length > 0);\nconst sentenceCount = Math.max(sentences.length, 1);\nconst avgWps = Math.round((wordCount / sentenceCount) * 10) / 10;\n\n// ----- Paragraphs -----\nconst paragraphs = text.split('\\n').filter(p => p.trim().length > 0);\n\n// ----- Vocabulary diversity -----\nconst uniqueWords = new Set(words.map(w => w.toLowerCase()));\nconst uniqueRatio = Math.round((uniqueWords.size / Math.max(wordCount, 1)) * 100) / 100;\n\n// ----- Syllable counting (count vowel groups) -----\nfunction countSyllables(word) {\n  word = word.toLowerCase();\n  let count = 0;\n  let prevVowel = false;\n  for (const ch of word) {\n    const isVowel = 'aeiouy'.includes(ch);\n    if (isVowel && !prevVowel) count++;\n    prevVowel = isVowel;\n  }\n  return Math.max(1, count);\n}\n\nconst totalSyllables = words.reduce((sum, w) => sum + countSyllables(w), 0);\n\n// ----- Flesch Reading Ease (higher = easier to read) -----\nconst flesch = Math.round(\n  (206.835 - 1.015 * avgWps - 84.6 * (totalSyllables / Math.max(wordCount, 1))) * 10\n) / 10;\n\n// ----- Length check against rubric -----\nconst minWords = parseInt(data.min_words) || 0;\nconst maxWords = parseInt(data.max_words) || 99999;\nconst meetsLength = wordCount >= minWords && wordCount <= maxWords;\n\n// ----- Build rubric text for the LLM -----\nconst rubricLines = [];\nfor (let i = 1; i <= 4; i++) {\n  const name = data['criterion_' + i];\n  const weight = data['weight_' + i];\n  if (name && weight) {\n    rubricLines.push(`- ${name} (out of ${weight} points)`);\n  }\n}\nconst rubricText = rubricLines.join('\\n');\n\n// ----- Output -----\nreturn [{\n  json: {\n    student_id: prev.student_id,\n    student_name: prev.student_name,\n    student_email: prev.student_email,\n    course_code: prev.course_code,\n    assignment_id: prev.assignment_id,\n    submitted_at: prev.submitted_at,\n    essay_text: text,\n    word_count: wordCount,\n    sentence_count: sentenceCount,\n    paragraph_count: paragraphs.length,\n    avg_words_per_sentence: avgWps,\n    unique_word_ratio: uniqueRatio,\n    flesch_reading_ease: flesch,\n    meets_length: meetsLength,\n    min_words: minWords,\n    max_words: maxWords,\n    rubric_text: rubricText,\n  }\n}];"
      },
      "id": "d798d553-56c6-4b4e-badf-87ceb83834e8",
      "name": "Compute Metrics (JavaScript)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        256
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an experienced academic writing instructor providing constructive feedback to a student. Grade the essay below using the rubric. Be encouraging but honest.\n\nSTUDENT NAME: {{ $json.student_name }}\nCOURSE: {{ $json.course_code }}\nASSIGNMENT: {{ $json.assignment_id }}\n\nOBJECTIVE METRICS (from automated analysis):\n- Word count: {{ $json.word_count }} (required range met: {{ $json.meets_length }})\n- Flesch reading ease: {{ $json.flesch_reading_ease }}\n- Avg sentence length: {{ $json.avg_words_per_sentence }} words\n- Vocabulary diversity: {{ $json.unique_word_ratio }}\n\nRUBRIC (score each criterion out of its maximum points):\n{{ $json.rubric_text }}\n\nESSAY:\n\"\"\"\n{{ $json.essay_text }}\n\"\"\"\n\nINSTRUCTIONS:\n1. Score each rubric criterion out of its stated maximum.\n2. Sum into a total out of 100 and assign a letter grade (A: 90+, B: 80-89, C: 70-79, D: 60-69, F: below 60).\n3. Identify 2-3 specific strengths with brief evidence.\n4. Identify 2-3 specific, actionable improvement areas.\n5. Write a ~150-word personalized feedback message addressed to the student by name.\n\nReturn ONLY a valid JSON object matching this schema exactly (no markdown fences, no prose around it):\n{\n  \"scores\": {\"<criterion_name>\": <number>, ...},\n  \"total\": <sum 0-100>,\n  \"letter_grade\": \"<A|B|C|D|F>\",\n  \"strengths\": [\"<strength 1>\", \"<strength 2>\"],\n  \"improvements\": [\"<improvement 1>\", \"<improvement 2>\"],\n  \"personalized_feedback\": \"<~150 words addressed to the student by name>\"\n}"
      },
      "id": "22cc9e21-25d3-45c3-bb99-ce320a3a2bbd",
      "name": "Grade Essay (LLM)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1504,
        272
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "maxTokensToSample": 1024,
          "temperature": 0.3
        }
      },
      "id": "d697c412-e4df-4446-8ca1-aec22795f300",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        1520,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// ----- Parse the LLM response safely -----\nconst llmResponse = $input.first().json.text || $input.first().json.output || '';\nconst metrics = $('Compute Metrics (Python)').first().json;\n\n// Strip markdown code fences if Groq wrapped the JSON\nlet cleaned = llmResponse.trim()\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/\\s*```$/, '');\n\nlet parsed = null;\nlet parseError = null;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  // Fallback: extract first JSON object\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try {\n      parsed = JSON.parse(match[0]);\n    } catch (e2) {\n      parseError = 'JSON parse failed: ' + e2.message;\n    }\n  } else {\n    parseError = 'No JSON object found in response';\n  }\n}\n\nif (parsed && typeof parsed.total !== 'undefined') {\n  const scoresText = Object.entries(parsed.scores || {})\n    .map(([k, v]) => `  - ${k}: ${v}`)\n    .join('\\n');\n  const strengthsText = (parsed.strengths || [])\n    .map(s => `  • ${s}`).join('\\n');\n  const improvementsText = (parsed.improvements || [])\n    .map(s => `  • ${s}`).join('\\n');\n\n  return [{\n    json: {\n      grade_valid: true,\n      total: parsed.total,\n      letter_grade: parsed.letter_grade || '',\n      scores: parsed.scores || {},\n      scores_text: scoresText,\n      strengths: parsed.strengths || [],\n      strengths_text: strengthsText,\n      improvements: parsed.improvements || [],\n      improvements_text: improvementsText,\n      personalized_feedback: parsed.personalized_feedback || '',\n      // Pass through student info\n      student_id: metrics.student_id,\n      student_name: metrics.student_name,\n      student_email: metrics.student_email,\n      course_code: metrics.course_code,\n      assignment_id: metrics.assignment_id,\n      submitted_at: metrics.submitted_at,\n      word_count: metrics.word_count,\n      flesch_reading_ease: metrics.flesch_reading_ease,\n    }\n  }];\n}\n\n// Failure path — LLM output was unparseable\nreturn [{\n  json: {\n    grade_valid: false,\n    error: parseError || 'Invalid LLM response structure',\n    raw_response: llmResponse.substring(0, 500),\n    student_id: metrics.student_id,\n    student_name: metrics.student_name,\n    student_email: metrics.student_email,\n    assignment_id: metrics.assignment_id,\n  }\n}];\n"
      },
      "id": "5d0715d4-3c98-409e-acc9-7f032b9ea0a3",
      "name": "Parse LLM Response",
      "type": "n8n-nodes-base.code",
